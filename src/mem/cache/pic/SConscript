# -*- mode:python -*-
#
# PolymorPIC DMA engine for gem5: address-chunk splitting and DMA response
# reassembly, plus the P2S-facing/memory-facing ports (DMAEngine is a real
# SimObject -- see pic_dma_engine.hh for the port topology and the
# "one request from P2S = one row = one response" design note).

# import the SCons environment
Import('*')

# mod: p2s_arbiter
SimObject('pic_dma_engine.py', sim_objects=['DMAEngine'])
SimObject('access_bank_arb.py', sim_objects=['AccessBankArb'])

# only list .cc files here; .hh files are automatically included by the build system
Source('pic_dma_engine.cc')
Source('access_bank_arb.cc')

# use -debug-flags=PICDMA to open the debug output for the DMA engine
DebugFlag('PICDMA', 'DMA request generation, page split, responses')

# use -debug-flags=PICBankArb to open the debug output for the bank arbiter
DebugFlag('PICBankArb', 'Bank access arbiter: P2S req/resp, grants, blocks')
